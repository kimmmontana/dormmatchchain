# Copy this file to .env and fill in the values.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Production settings (defaults suit local development).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL connection string; SQLite is used when empty.
DATABASE_URL=

# Stellar wallet payments (optional). The testnet contract is listed in
# blockchain/deployments/testnet.json. Leave empty to disable.
STELLAR_CONTRACT_ID=
# Secret key (S...) of the contract admin, used by Django admin actions.
STELLAR_ADMIN_SECRET=

# S3-compatible storage for uploaded dorm images (e.g. Supabase Storage).
# Leave S3_BUCKET empty to store uploads in media/ on local disk.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the bucket, e.g. https://<project>.supabase.co/storage/v1/object/public/<bucket>
S3_PUBLIC_URL=
